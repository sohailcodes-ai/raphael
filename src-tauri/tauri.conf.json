{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RAPHAEL",
  "version": "0.1.0",
  "identifier": "ai.sohailcodes.raphael",
  "build": {
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RAPHAEL",
        "width": 420,
        "height": 640,
        "minWidth": 340,
        "minHeight": 480,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
